{
  "schemaVersion": 1,
  "id": "jukeboxplus",
  "version": "${version}",
  "name": "JukeboxPlus",
  "description": "A proper music player for Minecraft: browse and play every vanilla track and music disc, see what is playing, and keep a history.",
  "authors": ["MaxLananas"],
  "contact": {
    "homepage": "https://github.com/MaxLananas/JukeBoxPlus",
    "sources": "https://github.com/MaxLananas/JukeBoxPlus",
    "issues": "https://github.com/MaxLananas/JukeBoxPlus/issues"
  },
  "license": "MIT",
  "icon": "assets/jukeboxplus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.jukeboxplus.JukeboxPlus"]
  },
  "mixins": [
    {
      "config": "jukeboxplus.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
